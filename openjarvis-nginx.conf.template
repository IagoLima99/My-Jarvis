server {
    listen 8080;
    server_name _;

    location = /voice {
        return 302 /voice/;
    }

    # Dedicated hands-free voice UI. It only reaches OpenJarvis through the
    # same authenticated loopback proxy as the standard interface.
    location /voice/ {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ /voice/index.html;
        add_header Cache-Control "no-store";
    }

    location / {
        proxy_pass http://jarvis:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization "Bearer ${OPENJARVIS_API_KEY}";
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

# A separate loopback origin keeps the continuous-voice UI isolated from the
# OpenJarvis dashboard PWA and its existing service-worker cache.
server {
    listen 8081;
    server_name _;
    root /usr/share/nginx/html/voice;
    index index.html;

    location /v1/ {
        proxy_pass http://jarvis:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization "Bearer ${OPENJARVIS_API_KEY}";
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-store";
    }
}
